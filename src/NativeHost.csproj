<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>dalbearXterm</AssemblyName>
    <RootNamespace>DalbearXterm</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>../assets/icon.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NativeHost.cs"/>
    <Compile Include="Updates.cs"/>
    <Compile Include="AppTheme.cs"/>
    <Reference Include="System.Windows.Forms"/>
    <Reference Include="System.Drawing"/>
    <Reference Include="System.Web.Extensions"/>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31"/>
    <PackageReference Include="Velopack" Version="1.2.0"/>
  </ItemGroup>
</Project>
